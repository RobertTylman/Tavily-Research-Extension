# Optional LangSmith tracing for local/dev builds.
# Do not ship a public Chrome Web Store build with a LangSmith API key baked in.
VITE_LANGSMITH_TRACING=false
VITE_LANGSMITH_API_KEY=
VITE_LANGSMITH_PROJECT=fact-checker-dev
VITE_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
VITE_LANGSMITH_WORKSPACE_ID=
VITE_LANGSMITH_SAMPLE_RATE=1
VITE_LANGSMITH_TEXT_MODE=preview
